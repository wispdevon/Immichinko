{
  "name": "immichinko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "node -e \"for(const s of ['','-wal','-shm']) require('node:fs').rmSync('/tmp/immichinko-e2e.sqlite'+s,{force:true})\" && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:integrated": "IMMICHINKO_BASE_PATH=/immichinko IMMICHINKO_BUILD_DIR=build-integrated vite build",
    "test:integration": "node -e \"for(const s of ['','-wal','-shm']) require('node:fs').rmSync('/tmp/immichinko-integration.sqlite'+s,{force:true})\" && playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@immich/ui": "0.86.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.48.0",
    "svelte": "^5.56.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
