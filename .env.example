# Immich server root URL, without /api. Must be reachable from the container.
IMMICH_URL=http://immich.home:2283
# Optional browser-facing Immich root URL if IMMICH_URL uses a Docker hostname.
IMMICH_PUBLIC_URL=
# Dedicated key: asset.read, asset.view, asset.update
IMMICH_API_KEY=
TZ=Asia/Bangkok
# Exact browser-facing URL (required for same-origin mutation checks).
ORIGIN=http://localhost:3000
# Compose binds localhost by default. Set a private interface for LAN use.
BIND_ADDRESS=127.0.0.1
PORT=3000
# Local development only; Compose uses /data/immichinko.sqlite.
DATABASE_PATH=data/immichinko.sqlite
